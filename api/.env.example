# ============================================================
#  storage-app / API (NestJS) — biến môi trường
#  Copy file này thành .env rồi điền giá trị thật.
#  KHÔNG điền giá trị thật vào file .example này (file được git theo dõi).
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
# Origin của frontend Angular (cho CORS)
WEB_ORIGIN=http://localhost:4200

# --- Supabase (Postgres + Auth) ---
# DÙNG CONNECTION POOLER (có IPv4) — kết nối trực tiếp db.xxx.supabase.co giờ IPv6-only.
# Lấy ở Dashboard -> Project Settings -> Database -> "Session pooler".
# username = postgres.<project-ref> ; mật khẩu phải URL-encode (VD '@' -> %40).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# JWT secret đối xứng của Supabase (Project Settings -> API -> JWT Secret) — verify token (mục 3).
SUPABASE_JWT_SECRET=
# Dùng cho worker cập nhật Realtime / thao tác service-role phía server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ + cache) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Google Cloud Storage (XML API tương thích S3) ---
# ID project chứa bucket (chỉ để tham chiếu/log).
GCS_PROJECT_ID=
# Tên bucket, VD: storage-cloud-1
GCS_BUCKET=
# Location của bucket, dùng làm region khi ký SigV4.
# Multi-region asia -> "asia"; single region -> "asia-southeast1"...
GCS_REGION=asia
# Endpoint XML API — CHỈ host, KHÔNG có tên bucket ở đuôi. Hầu như không cần đổi.
GCS_ENDPOINT=https://storage.googleapis.com
# HMAC key gắn với service account:
# Console -> Cloud Storage -> Settings -> Interoperability -> Create key for a service account.
# Service account đó cần role "Storage Object Admin" trên bucket.
GCS_ACCESS_KEY_ID=
GCS_SECRET_ACCESS_KEY=
# Base URL public (VD https://storage.googleapis.com/<bucket> hoặc CDN domain).
# ĐỂ TRỐNG nếu bucket bật Public access prevention — code sẽ tự dùng presigned URL.
GCS_PUBLIC_BASE_URL=

# --- Google Gemini (embedding + OCR) ---
GEMINI_API_KEY=
# Model embedding (768 chiều, khớp pgvector). Đổi provider chỉ cần sửa env + AiEmbeddingService.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Model sinh nội dung dùng cho OCR ảnh/PDF scan (khác model embedding).
# LƯU Ý: gemini-2.5-flash đã bị Google ngừng cấp cho tài khoản mới (404 NOT_FOUND).
# Kiểm tra model nào tài khoản bạn dùng được:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_OCR_MODEL=gemini-3.6-flash

# --- Giới hạn (mục 5.D) ---
# Trần dung lượng 1 file (MB). 2GB = 2048.
MAX_FILE_SIZE_MB=2048
# Kích thước chunk multipart (MB).
UPLOAD_CHUNK_SIZE_MB=8

# --- Thùng rác (mục 7.E/11.K) ---
# Số ngày giữ file/folder trong Thùng rác trước khi xoá vĩnh viễn tự động.
TRASH_RETENTION_DAYS=30

# --- Chia sẻ (mục 12.G) ---
# Gốc URL để dựng link chia sẻ đầy đủ (mặc định lấy WEB_ORIGIN nếu bỏ trống).
SHARE_BASE_URL=http://localhost:4200
# Ký token phiên sau khi mở khoá mật khẩu link. Bỏ trống = sinh ngẫu nhiên mỗi
# lần boot (link có mật khẩu phải mở khoá lại sau khi restart server).
SHARE_SESSION_SECRET=
# TTL (giây) của presigned URL cho link công khai — thu hồi có hiệu lực trong
# khoảng này (mục 12.B). KHÔNG để quá dài.
SHARE_CONTENT_TTL_SECONDS=600
