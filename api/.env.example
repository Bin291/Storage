# ============================================================
#  storage-app / API (NestJS) — biến môi trường
#  Copy file này thành .env rồi điền giá trị thật.
#  KHÔNG điền giá trị thật vào file .example này (file được git theo dõi).
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
# Origin của frontend Angular (cho CORS)
WEB_ORIGIN=http://localhost:4200

# --- Supabase (Postgres + Auth) ---
# DÙNG CONNECTION POOLER (có IPv4) — kết nối trực tiếp db.xxx.supabase.co giờ IPv6-only.
# Lấy ở Dashboard -> Project Settings -> Database -> "Session pooler".
# username = postgres.<project-ref> ; mật khẩu phải URL-encode (VD '@' -> %40).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# JWT secret đối xứng của Supabase (Project Settings -> API -> JWT Secret) — verify token (mục 3).
SUPABASE_JWT_SECRET=
# Dùng cho worker cập nhật Realtime / thao tác service-role phía server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ + cache) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endpoint để AWS SDK gọi API — CHỈ host, KHÔNG có tên bucket ở đuôi.
R2_ENDPOINT=
# Domain public qua Cloudflare CDN (r2.dev hoặc custom domain) — dùng cho download/thumbnail.
R2_PUBLIC_BASE_URL=

# --- Google Gemini (embedding + OCR) ---
GEMINI_API_KEY=
# Model embedding (768 chiều, khớp pgvector). Đổi provider chỉ cần sửa env + AiEmbeddingService.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Model sinh nội dung dùng cho OCR ảnh/PDF scan (khác model embedding).
GEMINI_OCR_MODEL=gemini-2.5-flash

# --- Giới hạn (mục 5.D) ---
# Trần dung lượng 1 file (MB). 2GB = 2048.
MAX_FILE_SIZE_MB=2048
# Kích thước chunk multipart (MB).
UPLOAD_CHUNK_SIZE_MB=8

# --- Thùng rác (mục 7.E/11.K) ---
# Số ngày giữ file/folder trong Thùng rác trước khi xoá vĩnh viễn tự động.
TRASH_RETENTION_DAYS=30
